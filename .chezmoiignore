.config/dorothy/commands.local

# Omarchy owns these on Omarchy machines: ~/.config/nvim is a LazyVim install wired
# to `omarchy theme set`, and ~/.bashrc sources Omarchy's env-bootstrap + default rc.
.config/nvim
.bashrc
.bash_profile

# Kept in git for recovery, never written to $HOME: root-owned files plus their
# installer. See office-tv-switch/README.md.
office-tv-switch

# Kept in git for reference, never written to $HOME.
# See gpg-yubikey/README.md.
gpg-yubikey

# Desk-specific USB A/B switch + TV automation. Opt in per machine with
# [data.officeTv] enabled = true in ~/.config/chezmoi/chezmoi.toml.
{{- if not (dig "officeTv" "enabled" false .) }}
.local/bin/cosmic-usb-display.sh
.config/systemd/user/cosmic-usb-display.service
{{- end }}
