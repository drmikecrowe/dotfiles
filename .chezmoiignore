.ssh
.tmux/plugins/*/.git
.zsh-custom/plugins/*/.git
.tmux/plugins
.zsh-custom/plugins
.tmux/tmux.conf.old
.zsh-custom/.local
.config/dorothy/commands.local

# Omarchy owns these on Omarchy machines: ~/.config/nvim is a LazyVim install wired
# to `omarchy theme set`, and ~/.bashrc sources Omarchy's env-bootstrap + default rc.
.config/nvim
.bashrc
.bash_profile

# Kept in git for recovery, never written to $HOME: root-owned files plus their
# installer. See office-tv-switch/README.md.
office-tv-switch

# Kept in git for reference, never written to $HOME.
# See gpg-yubikey/README.md.
gpg-yubikey

# Desk-specific USB A/B switch + TV automation. Opt in per machine with
# [data.officeTv] enabled = true in ~/.config/chezmoi/chezmoi.toml.
{{- if not (dig "officeTv" "enabled" false .) }}
.local/bin/cosmic-usb-display.sh
.config/systemd/user/cosmic-usb-display.service
{{- end }}

# Claude's own git signing and push wiring (keys stay in ~/.ssh/signing, never here).
# Opt in per machine with [data.claudeGit] enabled = true in
# ~/.config/chezmoi/chezmoi.toml.
{{- if not (dig "claudeGit" "enabled" false .) }}
.config/git/automation.gitconfig
.config/git/automation-*.gitconfig
.config/git/allowed_signers.asc
.config/git/automation.gitconfig.asc
.config/git/automation-*.gitconfig.asc
{{- end }}

# Client-specific git identities (encrypted). On by default; turn off on a machine that
# cannot decrypt them with [data.gitClients] enabled = false in ~/.config/chezmoi/chezmoi.toml.
{{- if not (dig "gitClients" "enabled" true .) }}
.config/git/clients.gitconfig.asc
.config/git/gitconfig-Mikkel.asc
.config/git/gitconfig-Personal.asc
.config/git/gitconfig-Pinnacle.asc
.config/git/gitconfig-WRStudios.asc
{{- end }}
